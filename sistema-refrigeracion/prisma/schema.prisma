generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model cliente {
  id_cliente               Int                        @id @default(autoincrement())
  nombre                   String                     @db.VarChar(50)
  apellido                 String                     @db.VarChar(50)
  cuit                     String?                    @db.VarChar(20)
  calle                    String?                    @db.VarChar(100)
  num_calle                Int?
  telefono                 String?                    @db.VarChar(20)
  email                    String?                    @db.VarChar(100)
  estado                   Boolean?                   @default(true)
  localidad                String?                    @db.VarChar(100)
  historial_notificaciones historial_notificaciones[]
  orden_trabajo            orden_trabajo[]
  presupuesto              presupuesto[]
  recibo                   recibo[]
}

model compra_insumo {
  id_compra      Int              @id @default(autoincrement())
  id_proveedor   Int?
  fecha_compra   DateTime         @default(dbgenerated("CURRENT_DATE")) @db.Date
  costo_total    Decimal          @db.Decimal(10, 2)
  descripcion    String?
  neto           Decimal?         @db.Decimal(10, 2)
  alicuota_iva   Decimal?         @db.Decimal(5, 2)
  proveedor      proveedor?       @relation(fields: [id_proveedor], references: [id_proveedor], onDelete: Restrict, onUpdate: NoAction)
  detalle_compra detalle_compra[]

  @@index([fecha_compra])
  @@index([id_proveedor])
}

model detalle_compra {
  id_detalle_compra Int            @id @default(autoincrement())
  id_compra         Int?
  id_insumo         Int?
  cantidad          Int
  precio_unitario   Decimal        @db.Decimal(10, 2)
  compra_insumo     compra_insumo? @relation(fields: [id_compra], references: [id_compra], onDelete: Restrict, onUpdate: NoAction)
  insumo            insumo?        @relation(fields: [id_insumo], references: [id_insumo], onDelete: Restrict, onUpdate: NoAction)
}

model detalle_orden_insumo {
  id_detalle_ins  Int            @id @default(autoincrement())
  id_orden        Int?
  id_insumo       Int?
  cantidad_usada  Decimal        @db.Decimal(10, 3)
  precio_aplicado Decimal        @db.Decimal(10, 2)
  insumo          insumo?        @relation(fields: [id_insumo], references: [id_insumo], onDelete: Restrict, onUpdate: NoAction)
  orden_trabajo   orden_trabajo? @relation(fields: [id_orden], references: [id_orden], onDelete: Cascade, onUpdate: NoAction)
}

model detalle_orden_servicio {
  id_detalle_srv    Int            @id @default(autoincrement())
  id_orden          Int?
  id_servicio       Int?
  cantidad          Int            @default(1)
  precio_acordado   Decimal        @db.Decimal(10, 2)
  descripcion_libre String?        @db.VarChar(255)
  orden_trabajo     orden_trabajo? @relation(fields: [id_orden], references: [id_orden], onDelete: Cascade, onUpdate: NoAction)
  servicio          servicio?      @relation(fields: [id_servicio], references: [id_servicio], onDelete: Restrict, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model factura {
  id_factura               Int                        @id @default(autoincrement())
  id_orden                 Int?
  num_factura              String?                    @db.VarChar(50)
  tipo                     String?                    @db.VarChar(20)
  fecha_emision            DateTime                   @db.Date
  fecha_vencimiento        DateTime?                  @db.Date
  monto_total              Decimal                    @db.Decimal(10, 2)
  saldo_pendiente          Decimal                    @db.Decimal(10, 2)
  estado_pago              String                     @default("IMPAGA") @db.VarChar(20)
  descripcion              String?
  neto                     Decimal?                   @db.Decimal(10, 2)
  alicuota_iva             Decimal?                   @db.Decimal(5, 2)
  tipo_descuento           String?                    @db.VarChar(20)
  descuento_porcentaje     Decimal?                   @db.Decimal(5, 2)
  descuento_monto          Decimal?                   @db.Decimal(10, 2)
  equipo_descripcion       String?
  orden_trabajo            orden_trabajo?             @relation(fields: [id_orden], references: [id_orden], onDelete: Restrict, onUpdate: NoAction)
  historial_notificaciones historial_notificaciones[]
  pagos_parciales          pagos_parciales[]

  @@index([fecha_emision])
  @@index([estado_pago])
  @@index([id_orden])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model historial_notificaciones {
  id_notificacion   Int      @id @default(autoincrement())
  id_factura        Int?
  id_cliente        Int?
  tipo_notificacion String?  @db.VarChar(50)
  fecha_creacion    DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date
  estado            String?  @db.VarChar(20)
  descripcion       String?
  cliente           cliente? @relation(fields: [id_cliente], references: [id_cliente], onDelete: Cascade, onUpdate: NoAction)
  factura           factura? @relation(fields: [id_factura], references: [id_factura], onDelete: Cascade, onUpdate: NoAction)
}

model insumo {
  id_insumo            Int                    @id @default(autoincrement())
  id_proveedor         Int?
  nombre               String                 @db.VarChar(100)
  descripcion          String?                @db.VarChar(255)
  stock_actual         Decimal?               @default(0) @db.Decimal(10, 3)
  stock_minimo         Decimal?               @default(0) @db.Decimal(10, 3)
  precio_costo         Decimal                @db.Decimal(10, 2)
  precio_venta         Decimal                @db.Decimal(10, 2)
  estado               Boolean?               @default(true)
  detalle_compra       detalle_compra[]
  detalle_orden_insumo detalle_orden_insumo[]
  proveedor            proveedor?             @relation(fields: [id_proveedor], references: [id_proveedor], onUpdate: NoAction)
  servicioInsumos      servicio_insumo[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model orden_trabajo {
  id_orden               Int                      @id @default(autoincrement())
  id_cliente             Int?
  fecha_creacion         DateTime                 @default(dbgenerated("CURRENT_DATE")) @db.Date
  estado_trabajo         String?                  @default("Pendiente") @db.VarChar(20)
  notas_internas         String?
  detalle_orden_insumo   detalle_orden_insumo[]
  detalle_orden_servicio detalle_orden_servicio[]
  factura                factura[]
  cliente                cliente?                 @relation(fields: [id_cliente], references: [id_cliente], onDelete: Restrict, onUpdate: NoAction)
  presupuesto            presupuesto[]

  @@index([fecha_creacion])
  @@index([estado_trabajo])
  @@index([id_cliente])
}

model pagos_parciales {
  id_pago      Int     @id @default(autoincrement())
  id_factura   Int
  monto_pagado Decimal @db.Decimal(10, 2)
  id_recibo    Int
  recibo       recibo  @relation(fields: [id_recibo], references: [id_recibo], onDelete: Cascade, onUpdate: NoAction, map: "fk_pagos_parciales_recibo")
  factura      factura @relation(fields: [id_factura], references: [id_factura], onDelete: Cascade, onUpdate: NoAction)

  @@index([id_factura], map: "idx_pagos_parciales_id_factura")
  @@index([id_recibo], map: "idx_pagos_parciales_id_recibo")
}

model proveedor {
  id_proveedor     Int             @id @default(autoincrement())
  razon_social     String          @db.VarChar(100)
  cuit             String?         @unique @db.VarChar(20)
  telefono         String?         @db.VarChar(20)
  email            String?         @db.VarChar(100)
  nombre_proveedor String?         @db.VarChar(100)
  estado           Boolean?        @default(true)
  compra_insumo    compra_insumo[]
  insumo           insumo[]
}

model servicio {
  id_servicio            Int                      @id @default(autoincrement())
  nombre                 String                   @db.VarChar(100)
  descripcion            String?                  @db.VarChar(255)
  precio                 Decimal                  @db.Decimal(10, 2)
  estado                 Boolean?                 @default(true)
  detalle_orden_servicio detalle_orden_servicio[]
  detalle_presupuesto    detalle_presupuesto[]
  servicio_insumo        servicio_insumo[]
}

model servicio_insumo {
  id_servicio_ins Int      @id @default(autoincrement())
  id_servicio     Int
  id_insumo       Int
  cantidad        Decimal  @db.Decimal(10, 3)
  insumo          insumo   @relation(fields: [id_insumo], references: [id_insumo])
  servicio        servicio @relation(fields: [id_servicio], references: [id_servicio], onDelete: Cascade)
}

model playing_with_neon {
  id    Int    @id @default(autoincrement())
  name  String
  value Float? @db.Real
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model recibo {
  id_recibo       Int               @id @default(autoincrement())
  id_cliente      Int
  fecha_pago      DateTime          @default(dbgenerated("CURRENT_DATE")) @db.Date
  monto_total     Decimal           @db.Decimal(10, 2)
  forma_pago      String?           @db.VarChar(50)
  observacion     String?
  pagos_parciales pagos_parciales[]
  cliente         cliente           @relation(fields: [id_cliente], references: [id_cliente], onUpdate: NoAction)
  retencion       retencion[]

  @@index([fecha_pago], map: "idx_recibo_fecha_pago")
  @@index([id_cliente], map: "idx_recibo_id_cliente")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model retencion {
  id_retencion Int     @id @default(autoincrement())
  id_recibo    Int
  tipo         String  @db.VarChar(20)
  direccion    String  @default("SUFRIDA") @db.VarChar(10)
  monto        Decimal @db.Decimal(10, 2)
  recibo       recibo  @relation(fields: [id_recibo], references: [id_recibo], onDelete: Cascade, onUpdate: NoAction)

  @@index([id_recibo], map: "idx_retencion_id_recibo")
  @@index([tipo], map: "idx_retencion_tipo")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model detalle_presupuesto {
  id_detalle      Int         @id @default(autoincrement())
  id_presupuesto  Int
  orden_linea     Int         @default(1)
  cantidad        Decimal     @db.Decimal(10, 3)
  descripcion     String
  precio_unitario Decimal     @db.Decimal(10, 2)
  id_servicio     Int?
  presupuesto     presupuesto @relation(fields: [id_presupuesto], references: [id_presupuesto], onDelete: Cascade, onUpdate: NoAction)
  servicio        servicio?   @relation(fields: [id_servicio], references: [id_servicio], onDelete: NoAction, onUpdate: NoAction)

  @@index([id_presupuesto], map: "idx_detalle_presupuesto_id_presupuesto")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model presupuesto {
  id_presupuesto             Int                   @id @default(autoincrement())
  numero                     Int                   @unique @default(autoincrement())
  id_cliente                 Int?
  destinatario_nombre        String                @db.VarChar(150)
  destinatario_cuit          String?               @db.VarChar(20)
  destinatario_domicilio     String?               @db.VarChar(150)
  destinatario_localidad     String?               @db.VarChar(100)
  destinatario_condicion_iva String?               @db.VarChar(50)
  fecha_emision              DateTime              @default(dbgenerated("CURRENT_DATE")) @db.Date
  validez_dias               Int                   @default(5)
  condicion_pago             String?               @db.VarChar(100)
  alicuota_iva               Decimal               @default(21) @db.Decimal(5, 2)
  estado                     String                @default("PENDIENTE") @db.VarChar(20)
  observaciones              String?
  id_orden                   Int?
  detalle_presupuesto        detalle_presupuesto[]
  cliente                    cliente?              @relation(fields: [id_cliente], references: [id_cliente], onUpdate: NoAction)
  orden_trabajo              orden_trabajo?        @relation(fields: [id_orden], references: [id_orden], onUpdate: NoAction)

  @@index([estado], map: "idx_presupuesto_estado")
  @@index([fecha_emision], map: "idx_presupuesto_fecha_emision")
  @@index([id_cliente], map: "idx_presupuesto_id_cliente")
}
